# ── Stage 1: Builder ───────────────────────────────────────────
FROM node:20-slim AS builder
RUN apt-get update && apt-get install -y libc6 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm
WORKDIR /app

# Copy root manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Copy package manifests for all workspace members
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api-server/package.json ./apps/api-server/

RUN pnpm install --frozen-lockfile

# Copy full source and build
COPY . .

RUN pnpm --filter @ecom/db generate
RUN pnpm --filter @ecom/db build
RUN pnpm --filter @ecom/shared build
RUN pnpm --filter @ecom/api build
RUN pnpm --filter @ecom/api-server build

# Deploy standalone production bundle
RUN pnpm deploy --filter @ecom/api-server --prod /app/deploy

# ── Stage 2: Production runner ─────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV production

# Copy the deployed application from builder
COPY --from=builder /app/deploy ./

EXPOSE 4000

# Run the compiled code using node
CMD ["node", "dist/index.js"]
