// affiliate.prisma
model AffiliateAgent {
  id             String        @id @default(cuid())
  userId         String        @unique
  tier           AffiliateTier @default(BRONZE)
  commissionRate Decimal       @db.Decimal(5, 2)
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())

  user        User           @relation(fields: [userId], references: [id])
  links       ReferralLink[]
  commissions Commission[]
}

enum AffiliateTier {
  BRONZE
  SILVER
  GOLD
}

model ReferralLink {
  id         String  @id @default(cuid())
  agentId    String
  targetType String // e.g., "PRODUCT", "CATEGORY", "HOME"
  targetId   String?
  slug       String  @unique

  agent  AffiliateAgent  @relation(fields: [agentId], references: [id])
  clicks ReferralClick[]
}

model ReferralClick {
  id        String   @id @default(cuid())
  linkId    String
  sessionId String
  ip        String?
  createdAt DateTime @default(now())

  link ReferralLink @relation(fields: [linkId], references: [id])
}

model Commission {
  id        String   @id @default(cuid())
  agentId   String
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING") // PENDING, CONFIRMED, PAID
  createdAt DateTime @default(now())

  agent AffiliateAgent @relation(fields: [agentId], references: [id])
  order Order          @relation(fields: [orderId], references: [id])
}
