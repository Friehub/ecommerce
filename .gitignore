# ─── Dependencies ──────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build outputs ─────────────────────────────────────────────────
dist/
build/
out/
**/.next/
*.tsbuildinfo
next-env.d.ts

# ─── Rust ──────────────────────────────────────────────────────────
# services/.gitignore handles target/ per-workspace
# Root-level just in case
target/

# ─── Environment files ─────────────────────────────────────────────
# Real env files must never be committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod
.env.staging
# .env.example IS committed — it is a safe template with no real values
# (the negation must come after the pattern it overrides)
!.env.example

# ─── Logs ──────────────────────────────────────────────────────────
*.log
logs/
*.log.*
services/*.log

# ─── SSL Certificates — never commit private keys ──────────────────
nginx/certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# ─── OS artifacts ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# ─── Editor / IDE ──────────────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo

# ─── Testing ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Docker ────────────────────────────────────────────────────────
# Local Docker volume data (if mounted inside repo)
data/
postgres_data/
redis_data/

# ─── Deployment artifacts ──────────────────────────────────────────
# Generated by scripts/deploy.sh on the VPS — not source
/opt/

# ─── Misc ──────────────────────────────────────────────────────────
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Internal docs not for public ──────────────────────────────────
docs/14-TAAS_EXTRACTION.md
claude.md
