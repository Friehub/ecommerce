# =========================================================
# APPLICATION
# =========================================================
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=warn

WEB_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

HOST=0.0.0.0
PORT=4000

# =========================================================
# SECURITY
# =========================================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET
AUTH_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET

INTERNAL_API_TOKEN=CHANGE_THIS_TO_A_SECURE_INTERNAL_TOKEN

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# =========================================================
# NEXTAUTH
# =========================================================
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_TRUST_HOST=true

# =========================================================
# DATABASE
# =========================================================
DATABASE_URL=postgresql://username:password@postgres:5432/ecommerce
DATABASE_POOL_SIZE=20
DATABASE_SSL=true

# =========================================================
# REDIS
# =========================================================
REDIS_URL=redis://username:password@redis:6379
REDIS_TLS=true

# =========================================================
# STORAGE (CLOUDFLARE R2 / S3)
# =========================================================
R2_BUCKET=ecommerce-production
R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.yourdomain.com

R2_ACCESS_KEY_ID=CHANGE_THIS
R2_SECRET_ACCESS_KEY=CHANGE_THIS

NEXT_PUBLIC_R2_URL=https://cdn.yourdomain.com

# =========================================================
# CDN
# =========================================================
CDN_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# =========================================================
# EMAIL (RESEND)
# =========================================================
RESEND_API_KEY=CHANGE_THIS
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# =========================================================
# SMS (TERMII)
# =========================================================
TERMII_API_KEY=CHANGE_THIS
TERMII_SENDER_ID=YourStore

# =========================================================
# SMS (AFRICAS TALKING)
# =========================================================
AFRICAS_TALKING_USERNAME=production
AFRICAS_TALKING_API_KEY=CHANGE_THIS

# =========================================================
# PAYSTACK
# =========================================================
PAYSTACK_SECRET_KEY=CHANGE_THIS
PAYSTACK_PUBLIC_KEY=CHANGE_THIS
PAYSTACK_WEBHOOK_SECRET=CHANGE_THIS

# =========================================================
# FLUTTERWAVE
# =========================================================
FLW_SECRET_KEY=CHANGE_THIS
FLW_PUBLIC_KEY=CHANGE_THIS
FLW_WEBHOOK_SECRET=CHANGE_THIS

# =========================================================
# MONNIFY
# =========================================================
MONNIFY_API_KEY=CHANGE_THIS
MONNIFY_SECRET_KEY=CHANGE_THIS
MONNIFY_CONTRACT_CODE=CHANGE_THIS

# =========================================================
# OAUTH PROVIDERS
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =========================================================
# SEARCH SERVICE
# =========================================================
SEARCH_SERVICE_URL=http://search-service:3001
SEARCH_INDEX_PATH=/data/search-index

# =========================================================
# INVENTORY SERVICE
# =========================================================
INVENTORY_SERVICE_URL=http://inventory-service:3002

# =========================================================
# AUCTION SERVICE
# =========================================================
AUCTION_SERVICE_URL=http://auction-service:3003

# =========================================================
# FRAUD SERVICE
# =========================================================
FRAUD_SERVICE_URL=http://fraud-service:3004

# =========================================================
# RECOMMENDATION SERVICE
# =========================================================
RECOMMENDATIONS_SERVICE_URL=http://recommendation-service:3005

# =========================================================
# IMAGE PROCESSING SERVICE
# =========================================================
IMAGE_PROCESSOR_SERVICE_URL=http://image-service:3006

# =========================================================
# ANALYTICS / OBSERVABILITY
# =========================================================
AXIOM_DATASET=production
AXIOM_TOKEN=CHANGE_THIS

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# =========================================================
# RATE LIMITING
# =========================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =========================================================
# CACHE
# =========================================================
CACHE_TTL_SECONDS=300

# =========================================================
# CORS
# =========================================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =========================================================
# FEATURE FLAGS
# =========================================================
ENABLE_ANALYTICS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_AUCTIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# =========================================================
# FILE UPLOAD LIMITS
# =========================================================
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =========================================================
# PLAYWRIGHT / E2E
# =========================================================
CI=true
PLAYWRIGHT_BASE_URL=https://staging.yourdomain.com
TEST_USER_EMAIL=test@yourdomain.com
TEST_USER_PASSWORD=CHANGE_THIS

# =========================================================
# RUST SERVICES
# =========================================================
RUST_LOG=warn
TOKIO_WORKER_THREADS=4

# =========================================================
# DOCKER
# =========================================================
COMPOSE_PROJECT_NAME=ecommerce-production

# =========================================================
# BUILD FLAGS
# =========================================================
SKIP_ENV_VALIDATION=false
IS_BUILD=false
BUILDING=false
NEXT_PHASE=production
