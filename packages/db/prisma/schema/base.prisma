// base.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global Enums
enum MediaType {
  IMAGE
  VIDEO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
