// catalog.prisma
model Category {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  parentId        String?
  commissionRate  Decimal @db.Decimal(5, 2)
  attributeSchema Json? // JSON schema for required attributes

  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  bannerUrl   String?
  description String?   @db.Text
  isVerified  Boolean   @default(false)
  products    Product[]
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  brandId     String
  categoryId  String
  sellerId    String
  status      ProductStatus @default(DRAFT)
  averageRating Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount   Int          @default(0)
  isGlobal      Boolean      @default(false)
  isOfficial    Boolean      @default(false)
  isExpress     Boolean      @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  seller   Seller           @relation(fields: [sellerId], references: [id])
  variants ProductVariant[]
  media    ProductMedia[]
  reviews  Review[]
  adGroups AdGroup[]
  questions ProductQuestion[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([sellerId])
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  DELETED
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  ean          String?  @unique // International Article Number (barcode) for warehouse scanning
  attributes   Json // e.g., { "color": "Red", "size": "XL" }
  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)
  weightGrams  Int?

  product       Product            @relation(fields: [productId], references: [id])
  stockLevels   StockLevel[]
  cartItems     CartItem[]
  orderLines    OrderLine[]
  flashSales    FlashSale[]
  reservations  StockReservation[]
  media         ProductMedia[]
  wishlistItems WishlistItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  variantId String?
  url       String
  type      MediaType @default(IMAGE)
  position  Int       @default(0)

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
}

model ProductQuestion {
  id        String   @id @default(cuid())
  productId String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])
  answers ProductAnswer[]

  @@index([productId])
  @@index([userId])
}

model ProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  text       String   @db.Text
  isSeller   Boolean  @default(false)
  createdAt  DateTime @default(now())

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@index([questionId])
  @@index([userId])
}
