{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "paths": {
      "@ecom/db": ["packages/db/dist"],
      "@ecom/shared": ["packages/shared/dist"],
      "@ecom/shared/*": ["packages/shared/dist/*"],
      "@ecom/api": ["packages/api/dist"],
      "@ecom/api/*": ["packages/api/dist/*"]
    }



  },
  "exclude": ["node_modules", "dist"]
}
