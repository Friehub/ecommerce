# ── Stage 1: Builder ───────────────────────────────────────────
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm
WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ecom/db generate
RUN pnpm --filter @ecom/db exec tsc -b --force
RUN pnpm --filter @ecom/shared exec tsc -b --force
RUN pnpm --filter @ecom/api exec tsc -b --force
RUN pnpm --filter @ecom/api-server exec tsc -b --force

# ── Stage 3: Production runner ─────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 apiuser

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps /app/apps

WORKDIR /app

USER apiuser

EXPOSE 4000

# Use node --import tsx for robust TS execution without shell wrappers
CMD ["node", "--import", "tsx", "apps/api-server/src/index.ts"]
