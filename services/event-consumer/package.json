    "prom-client": "^15.1.3",
    "opossum": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.0.0"
