{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@ecom/db": ["packages/db/index.ts"],
      "@ecom/shared": ["packages/shared/src/index.ts"],
      "@ecom/shared/*": ["packages/shared/src/*"],
      "@ecom/api": ["packages/api/index.ts"],
      "@ecom/api/*": ["packages/api/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
