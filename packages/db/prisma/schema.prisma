// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- IAM Domain ---

enum UserRole {
  BUYER
  SELLER
  AGENT
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(BUYER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  addresses     UserAddress[]
  oauthAccounts OAuthAccount[]
  sellerProfile Seller?
  orders        Order[]
  wallet        Wallet?
  affiliate     AffiliateAgent?
  disputes      Dispute[]      @relation("BuyerDisputes")
  reviews       Review[]
  notifications NotificationLog[]
  pref          NotificationPreference[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String   // e.g., "Home", "Office"
  line1     String
  city      String
  state     String
  country   String
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

// --- Catalog Domain ---

enum MediaType {
  IMAGE
  VIDEO
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  DELETED
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  parentId       String?
  commissionRate Decimal    @db.Decimal(5, 2)
  attributeSchema Json?      // JSON schema for required attributes
  
  parent         Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children       Category[] @relation("SubCategories")
  products       Product[]
}

model Brand {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  logoUrl    String?
  isVerified Boolean   @default(false)
  products   Product[]
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  brandId     String
  categoryId  String
  sellerId    String
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand       Brand         @relation(fields: [brandId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  seller      Seller        @relation(fields: [sellerId], references: [id])
  variants    ProductVariant[]
  media       ProductMedia[]
  reviews     Review[]
  adGroups    AdGroup[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([sellerId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  attributes   Json     // e.g., { "color": "Red", "size": "XL" }
  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)
  weightGrams  Int?
  
  product      Product  @relation(fields: [productId], references: [id])
  stockLevels  StockLevel[]
  cartItems    CartItem[]
  orderLines   OrderLine[]
  flashSales   FlashSale[]
  reservations StockReservation[]
  media        ProductMedia[]
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  variantId String?
  url       String
  type      MediaType @default(IMAGE)
  position  Int       @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

// --- Inventory Domain ---

enum WarehouseType {
  SELLER_MANAGED
  JUMIA_HUB
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
}

model Warehouse {
  id          String        @id @default(cuid())
  name        String
  address     String
  type        WarehouseType @default(SELLER_MANAGED)
  stockLevels StockLevel[]
}

model StockLevel {
  id           String    @id @default(cuid())
  variantId    String
  sellerId     String
  warehouseId  String
  qtyOnHand    Int       @default(0)
  qtyReserved  Int       @default(0)

  variant      ProductVariant @relation(fields: [variantId], references: [id])
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, sellerId, warehouseId])
}

model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  orderId   String?
  quantity  Int
  expiresAt DateTime
  status    ReservationStatus @default(ACTIVE)

  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  order     Order?            @relation(fields: [orderId], references: [id])
}

// --- Cart & Order Domain ---

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PackageStatus {
  PENDING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String     @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String         @id @default(cuid())
  cartId        String
  variantId     String
  sellerId      String
  quantity      Int
  priceSnapshot Decimal        @db.Decimal(12, 2)

  cart          Cart           @relation(fields: [cartId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal     @db.Decimal(12, 2)
  shippingFee   Decimal     @db.Decimal(12, 2)
  discount      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paymentMethod String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  packages      OrderPackage[]
  payments      Payment[]
  reservations  StockReservation[]
  commissions   Commission[]

  @@index([userId])
  @@index([status])
}

model OrderPackage {
  id                String        @id @default(cuid())
  orderId           String
  sellerId          String
  status            PackageStatus @default(PENDING)
  trackingNumber    String?
  estimatedDelivery DateTime?
  
  order             Order         @relation(fields: [orderId], references: [id])
  lines             OrderLine[]
  shipments         Shipment[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

model OrderLine {
  id               String       @id @default(cuid())
  packageId        String
  variantId        String
  quantity         Int
  unitPrice        Decimal      @db.Decimal(12, 2)
  discountApplied  Decimal      @db.Decimal(12, 2) @default(0)

  package          OrderPackage   @relation(fields: [packageId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  ledgerEntries    SellerLedgerEntry[]
  returns          ReturnShipment[]
  disputes         Dispute[]
  reviews          Review[]
  conversions      AdConversion[]
}

// --- Payment Domain ---

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  HELD      // Escrow
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  userId       String
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("NGN")
  method       String
  status       PaymentStatus @default(PENDING)
  providerRef  String?
  createdAt    DateTime      @default(now())

  order        Order         @relation(fields: [orderId], references: [id])
  refunds      Refund[]
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @db.Decimal(12, 2) @default(0)
  currency     String              @default("NGN")
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  reference   String?
  description String?
  createdAt   DateTime              @default(now())
  
  wallet      Wallet                @relation(fields: [walletId], references: [id])
}

model Refund {
  id        String        @id @default(cuid())
  paymentId String
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  reason    String?
  createdAt DateTime      @default(now())

  payment   Payment       @relation(fields: [paymentId], references: [id])
}

// --- Seller Domain ---

enum SellerTier {
  STANDARD
  EXPRESS
  BRAND
}

enum SellerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Seller {
  id           String       @id @default(cuid())
  userId       String       @unique
  businessName String
  tier         SellerTier   @default(STANDARD)
  status       SellerStatus @default(PENDING_VERIFICATION)
  rating       Decimal      @db.Decimal(3, 2) @default(0)
  createdAt    DateTime     @default(now())

  user         User             @relation(fields: [userId], references: [id])
  documents    SellerDocument[]
  products     Product[]
  ledger       SellerLedgerEntry[]
  statements   SellerStatement[]
  payouts      Payout[]
  adCampaigns  AdCampaign[]
  flashSales   FlashSale[]
  disputes     Dispute[]        @relation("SellerDisputes")
}

model SellerDocument {
  id       String         @id @default(cuid())
  sellerId String
  type     String         // e.g., "ID", "CAC", "BANK"
  url      String
  status   DocumentStatus @default(PENDING)
  
  seller   Seller         @relation(fields: [sellerId], references: [id])
}

// --- Seller Finance Domain ---

enum LedgerEntryType {
  SALE
  COMMISSION
  AD_SPEND
  PENALTY
  REFUND
}

model SellerLedgerEntry {
  id          String          @id @default(cuid())
  sellerId    String
  orderLineId String?
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())

  seller      Seller          @relation(fields: [sellerId], references: [id])
  orderLine   OrderLine?      @relation(fields: [orderLineId], references: [id])
}

model SellerStatement {
  id          String   @id @default(cuid())
  sellerId    String
  periodStart DateTime
  periodEnd   DateTime
  gross       Decimal  @db.Decimal(12, 2)
  commission  Decimal  @db.Decimal(12, 2)
  adSpend     Decimal  @db.Decimal(12, 2)
  penalties   Decimal  @db.Decimal(12, 2)
  net         Decimal  @db.Decimal(12, 2)
  status      String   // e.g., "OPEN", "CLOSED", "PAID"
  
  seller      Seller   @relation(fields: [sellerId], references: [id])
  payouts     Payout[]
}

model Payout {
  id          String   @id @default(cuid())
  sellerId    String
  statementId String
  amount      Decimal  @db.Decimal(12, 2)
  status      String   // e.g., "PENDING", "SUCCESS", "FAILED"
  bankRef     String?
  createdAt   DateTime @default(now())

  seller      Seller          @relation(fields: [sellerId], references: [id])
  statement   SellerStatement @relation(fields: [statementId], references: [id])
}

// --- Logistics Domain ---

enum AgentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum QCResult {
  PASS
  FAIL
}

model DeliveryAgent {
  id        String      @id @default(cuid())
  userId    String      @unique
  zone      String
  status    AgentStatus @default(ACTIVE)
  shipments Shipment[]
}

model Shipment {
  id              String         @id @default(cuid())
  packageId       String
  agentId         String
  pickupStationId String?
  status          ShipmentStatus @default(PENDING)
  proofUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  package         OrderPackage   @relation(fields: [packageId], references: [id])
  agent           DeliveryAgent  @relation(fields: [agentId], references: [id])
  pickupStation   PickupStation? @relation(fields: [pickupStationId], references: [id])
  events          ShipmentEvent[]
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  note       String?
  location   String?
  createdAt  DateTime       @default(now())

  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
}

model PickupStation {
  id        String     @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  lat       Float?
  lng       Float?
  isActive  Boolean    @default(true)
  shipments Shipment[]
}

model ReturnShipment {
  id               String   @id @default(cuid())
  orderLineId      String
  reason           String
  status           String
  qcResult         QCResult?
  refundTriggered  Boolean  @default(false)
  createdAt        DateTime @default(now())

  orderLine        OrderLine @relation(fields: [orderLineId], references: [id])
}

// --- Advertising Domain ---

enum AdType {
  SPONSORED
  BANNER
  TAKEOVER
}

enum AdGroupTargeting {
  MANUAL
  AUTO
}

enum AdKeywordMatchType {
  EXACT
  BROAD
}

model AdCampaign {
  id        String       @id @default(cuid())
  sellerId  String
  name      String
  type      AdType       @default(SPONSORED)
  status    String       // e.g., "ACTIVE", "PAUSED"
  budget    Decimal      @db.Decimal(12, 2)
  spent     Decimal      @db.Decimal(12, 2) @default(0)
  createdAt DateTime     @default(now())

  seller    Seller       @relation(fields: [sellerId], references: [id])
  groups    AdGroup[]
  impressions AdImpression[]
}

model AdGroup {
  id        String           @id @default(cuid())
  campaignId String
  productId String
  targeting AdGroupTargeting @default(AUTO)

  campaign  AdCampaign       @relation(fields: [campaignId], references: [id])
  product   Product          @relation(fields: [productId], references: [id])
  keywords  AdKeyword[]
}

model AdKeyword {
  id        String             @id @default(cuid())
  adGroupId String
  keyword   String
  matchType AdKeywordMatchType @default(BROAD)
  bid       Decimal            @db.Decimal(12, 2)

  adGroup   AdGroup            @relation(fields: [adGroupId], references: [id])
}

model AdImpression {
  id          String     @id @default(cuid())
  campaignId  String
  productId   String
  userId      String?
  searchQuery String?
  createdAt   DateTime   @default(now())

  campaign    AdCampaign @relation(fields: [campaignId], references: [id])
  clicks      AdClick[]
}

model AdClick {
  id           String         @id @default(cuid())
  impressionId String
  userId       String?
  createdAt    DateTime       @default(now())

  impression   AdImpression   @relation(fields: [impressionId], references: [id])
  conversions  AdConversion[]
}

model AdConversion {
  id          String   @id @default(cuid())
  clickId     String
  orderLineId String
  revenue     Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  click       AdClick   @relation(fields: [clickId], references: [id])
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
}

// --- Promotions Domain ---

enum PromoType {
  PERCENT
  FIXED
  BOGO
  FREE_SHIP
}

model Promotion {
  id         String     @id @default(cuid())
  name       String
  type       PromoType
  value      Decimal    @db.Decimal(12, 2)
  minOrder   Decimal    @db.Decimal(12, 2) @default(0)
  maxUses    Int?
  sellerId   String?    // Null means platform-wide
  createdAt  DateTime   @default(now())

  coupons    Coupon[]
}

model Coupon {
  id           String    @id @default(cuid())
  promotionId  String
  code         String    @unique
  isSingleUse  Boolean   @default(true)
  usedByUserId String?

  promotion    Promotion @relation(fields: [promotionId], references: [id])
}

model FlashSale {
  id          String   @id @default(cuid())
  variantId   String
  sellerId    String
  discountPct Int
  stockLimit  Int
  startAt     DateTime
  endAt       DateTime

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  seller      Seller         @relation(fields: [sellerId], references: [id])
}

// --- Affiliate Domain ---

enum AffiliateTier {
  BRONZE
  SILVER
  GOLD
}

model AffiliateAgent {
  id             String        @id @default(cuid())
  userId         String        @unique
  tier           AffiliateTier @default(BRONZE)
  commissionRate Decimal       @db.Decimal(5, 2)
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())

  user           User           @relation(fields: [userId], references: [id])
  links          ReferralLink[]
  commissions    Commission[]
}

model ReferralLink {
  id         String          @id @default(cuid())
  agentId    String
  targetType String          // e.g., "PRODUCT", "CATEGORY", "HOME"
  targetId   String?
  slug       String          @unique
  
  agent      AffiliateAgent  @relation(fields: [agentId], references: [id])
  clicks     ReferralClick[]
}

model ReferralClick {
  id        String       @id @default(cuid())
  linkId    String
  sessionId String
  ip        String?
  createdAt DateTime     @default(now())

  link      ReferralLink @relation(fields: [linkId], references: [id])
}

model Commission {
  id        String   @id @default(cuid())
  agentId   String
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING") // PENDING, CONFIRMED, PAID
  createdAt DateTime @default(now())

  agent     AffiliateAgent @relation(fields: [agentId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id])
}

// --- Dispute Domain ---

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum EvidenceType {
  PHOTO
  DOC
}

model Dispute {
  id          String        @id @default(cuid())
  orderLineId String
  buyerId     String
  sellerId    String
  reason      String
  status      DisputeStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id])
  buyer       User          @relation("BuyerDisputes", fields: [buyerId], references: [id])
  seller      Seller        @relation("SellerDisputes", fields: [sellerId], references: [id])
  messages    DisputeMessage[]
  evidence    DisputeEvidence[]
  resolutions DisputeResolution[]
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  dispute   Dispute  @relation(fields: [disputeId], references: [id])
}

model DisputeEvidence {
  id         String       @id @default(cuid())
  disputeId  String
  uploaderId String
  url        String
  type       EvidenceType @default(PHOTO)
  createdAt  DateTime     @default(now())

  dispute    Dispute      @relation(fields: [disputeId], references: [id])
}

model DisputeResolution {
  id          String   @id @default(cuid())
  disputeId   String
  moderatorId String
  ruling      String   // e.g., "BUYER", "SELLER", "SPLIT"
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id])
}

// --- Review Domain ---

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderLineId String
  rating      Int      @default(5)
  title       String?
  body        String?  @db.Text
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  media       ReviewMedia[]

  @@index([productId])
  @@index([userId])
}

model ReviewMedia {
  id       String @id @default(cuid())
  reviewId String
  url      String

  review   Review @relation(fields: [reviewId], references: [id])
}

// --- CMS Domain ---

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  placement String   // e.g., "HOME_TOP", "CAT_TECH"
  startAt   DateTime
  endAt     DateTime
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Notification Domain ---

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  channel   String  // e.g., "EMAIL", "SMS", "PUSH"
  eventType String
  isEnabled Boolean @default(true)

  user      User    @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  eventType String
  status    String   // e.g., "SENT", "FAILED"
  sentAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
