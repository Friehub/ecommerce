{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "paths": {
      "bullmq": ["node_modules/bullmq"],
      "@ecom/db": ["./packages/db"],
      "@ecom/db/*": ["./packages/db/*"],
      "@ecom/shared": ["./packages/shared"],
      "@ecom/shared/*": ["./packages/shared/*"],
      "@ecom/api": ["./packages/api"],
      "@ecom/api/*": ["./packages/api/*"]
    }



  },
  "files": [],
  "references": [
    { "path": "./packages/db" },
    { "path": "./packages/shared" },
    { "path": "./packages/api" },
    { "path": "./apps/api-server" }
  ],
  "exclude": ["node_modules", "dist"]
}
