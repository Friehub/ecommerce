# =========================================================
# CORE INFRASTRUCTURE
# =========================================================
# PostgreSQL connection string
# Example: postgresql://ecom:ecom@localhost:5432/ecom_dev
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom_dev"

# Redis connection string
# Example: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# =========================================================
# AUTHENTICATION (NextAuth.js)
# =========================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =========================================================
# PAYMENTS (Paystack)
# =========================================================
# Get these from dashboard.paystack.com
PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_WEBHOOK_SECRET="wh_..."

# =========================================================
# EMAIL (Resend)
# =========================================================
RESEND_API_KEY="re_..."
DEFAULT_FROM_EMAIL="onboarding@resend.dev"

# =========================================================
# STORAGE (Cloudflare R2 / S3 Compatible)
# =========================================================
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY="minioadmin"
R2_SECRET_KEY="minioadmin"
R2_BUCKET="ecom-media"
R2_PUBLIC_DOMAIN="http://localhost:9000/ecom-media"

# =========================================================
# DEPLOYMENT / BUILD FLAGS
# =========================================================
# Set to 'true' during production builds if keys are injected at runtime
SKIP_ENV_VALIDATION=false
NODE_ENV=development

# Database password used in docker-compose.infra.yml
DB_PASSWORD=ecom
REDIS_PASSWORD=ecom
