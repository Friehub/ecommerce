// seller.prisma
model Seller {
  id                    String       @id @default(cuid())
  userId                String       @unique
  businessName          String
  tier                  SellerTier   @default(STANDARD)
  status                SellerStatus @default(PENDING_VERIFICATION)
  rating                Decimal      @default(0) @db.Decimal(3, 2)
  // Payout account — set via setupPayoutAccount() after bank verification
  bankCode              String?      // Paystack bank code e.g. "044" for Access Bank
  bankAccountNumber     String?
  bankAccountName       String?      // Must match Paystack bank resolve response
  transferRecipientCode String?      // Set after successful POST /transferrecipient
  createdAt             DateTime     @default(now())

  user        User                @relation(fields: [userId], references: [id])
  documents   SellerDocument[]
  products    Product[]
  packages    OrderPackage[]
  ledger      SellerLedgerEntry[]
  statements  SellerStatement[]
  payouts     Payout[]
  adCampaigns AdCampaign[]
  flashSales  FlashSale[]
  disputes    Dispute[]           @relation("SellerDisputes")
}

enum SellerTier {
  STANDARD
  EXPRESS
  BRAND
}

enum SellerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model SellerDocument {
  id              String         @id @default(cuid())
  sellerId        String
  type            String         // "NIN" | "CAC" | "BANK_STATEMENT" | "UTILITY_BILL"
  url             String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        // populated when status = REJECTED
  reviewedAt      DateTime?      // timestamp of admin decision
  reviewedBy      String?        // adminId who made the decision

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
}

model SellerLedgerEntry {
  id          String          @id @default(cuid())
  sellerId    String
  orderLineId String?
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  status      LedgerStatus    @default(PENDING)
  availableAt DateTime?
  createdAt   DateTime        @default(now())

  seller    Seller     @relation(fields: [sellerId], references: [id])
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id])

  @@index([sellerId])
  @@index([orderLineId])
  @@index([status])
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  REVERSED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  AD_SPEND
  PENALTY
  REFUND
  WITHDRAWAL
}

model SellerStatement {
  id          String   @id @default(cuid())
  sellerId    String
  periodStart DateTime
  periodEnd   DateTime
  gross       Decimal  @db.Decimal(12, 2)
  commission  Decimal  @db.Decimal(12, 2)
  adSpend     Decimal  @db.Decimal(12, 2)
  penalties   Decimal  @db.Decimal(12, 2)
  net         Decimal  @db.Decimal(12, 2)
  status      String // e.g., "OPEN", "CLOSED", "PAID"

  seller  Seller   @relation(fields: [sellerId], references: [id])
  payouts Payout[]

  @@index([sellerId])
}

model Payout {
  id          String   @id @default(cuid())
  sellerId    String
  statementId String?
  amount      Decimal  @db.Decimal(12, 2)
  status      String // e.g., "PENDING", "SUCCESS", "FAILED"
  bankRef     String?
  createdAt   DateTime @default(now())

  seller    Seller          @relation(fields: [sellerId], references: [id])
  statement    SellerStatement? @relation(fields: [statementId], references: [id])

  @@index([sellerId])
  @@index([statementId])
}
