{
  "name": "jumia-clone-root",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ecom/db generate",
    "db:migrate": "pnpm --filter @ecom/db migrate",
    "db:seed": "pnpm --filter @ecom/db seed",
    "db:studio": "pnpm --filter @ecom/db studio",
    "test:e2e": "playwright test -c apps/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c apps/e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "bullmq": "^5.76.5"
  }
}
