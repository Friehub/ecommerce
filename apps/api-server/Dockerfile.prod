# ── Stage 1: Builder ───────────────────────────────────────────
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm
WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ecom/db generate
RUN pnpm --filter @ecom/db build
RUN pnpm --filter @ecom/shared build
RUN pnpm --filter @ecom/api build
RUN pnpm --filter @ecom/api-server build

# ── Stage 3: Production runner ─────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV production

RUN npm install -g pm2

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 apiuser

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/api-server /app/apps/api-server
COPY --from=builder /app/ecosystem.config.js /app/ecosystem.config.js

WORKDIR /app

USER apiuser

EXPOSE 4000

CMD ["pm2-runtime", "start", "ecosystem.config.js", "--only", "fastify-api"]
