# ── Stage 1: Builder ───────────────────────────────────────────
FROM node:20-slim AS builder
RUN apt-get update && apt-get install -y libc6 openssl && rm -rf /var/lib/apt/lists/*
# Use corepack (built into node:20) to pin pnpm version — avoids re-downloading on every build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy root manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Copy package manifests for all workspace members
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# Copy full source and build
COPY . .

RUN pnpm --filter @ecom/db generate
# Delete stale .tsbuildinfo files before compiling
RUN find . -name '*.tsbuildinfo' -delete
RUN pnpm --filter @ecom/db exec tsc -b
RUN pnpm --filter @ecom/shared exec tsc -b
RUN pnpm --filter @ecom/api exec tsc -b

# Build the Next.js app with a persistent BuildKit cache for .next/cache.
# On repeat builds this turns a 4-minute compile into ~60 seconds.
ENV NEXT_TELEMETRY_DISABLED 1
ENV SKIP_ENV_VALIDATION true
RUN --mount=type=cache,target=/app/apps/web/.next/cache \
    pnpm --filter @ecom/web build

# ── Stage 3: Production runner ─────────────────────────────────
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

# Standalone output contains only what is needed to run
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["apps/web/server.js"]
