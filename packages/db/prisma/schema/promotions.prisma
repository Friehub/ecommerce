// promotions.prisma
model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  value       Decimal       @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean       @default(true)

  coupons Coupon[]
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  promotionId String
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id])
}

model FlashSale {
  id        String   @id @default(cuid())
  variantId String
  sellerId  String
  salePrice Decimal  @db.Decimal(12, 2)
  qtyLimit  Int
  qtySold   Int      @default(0)
  startTime DateTime
  endTime   DateTime

  variant ProductVariant @relation(fields: [variantId], references: [id])
  seller  Seller         @relation(fields: [sellerId], references: [id])
}
