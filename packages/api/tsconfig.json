{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "composite": true,
    "declaration": true,
    "rootDir": ".",
    "paths": {
      "@ecom/db": ["../../packages/db/index.ts"],
      "@ecom/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "scripts"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/shared" }
  ]
}
