FROM node:20-slim AS builder
RUN apt-get update && apt-get install -y libc6 && rm -rf /var/lib/apt/lists/*
# Use corepack to pin pnpm — avoids re-downloading on every build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy manifests first so the install layer is cached unless deps change
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

# Copy source after install to preserve the install cache layer
COPY . .

RUN pnpm --filter @ecom/db generate
# Delete stale .tsbuildinfo before compiling to avoid corruption without --force
RUN find . -name '*.tsbuildinfo' -delete
RUN pnpm --filter @ecom/db exec tsc -b
RUN pnpm --filter @ecom/shared exec tsc -b
RUN pnpm --filter @ecom/api exec tsc -b

FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV production

RUN apt-get update && apt-get install -y libc6 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages

USER worker

CMD ["node", "--import", "tsx", "packages/api/scripts/run-workers.ts"]
