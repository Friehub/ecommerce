// order.prisma
model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal     @db.Decimal(12, 2)
  shippingFee   Decimal     @db.Decimal(12, 2)
  discount      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paymentMethod String
  addressId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  address      UserAddress?       @relation(fields: [addressId], references: [id])
  packages     OrderPackage[]
  payments     Payment[]
  reservations StockReservation[]
  commissions  Commission[]
  disputes     Dispute[]

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

model OrderPackage {
  id                String        @id @default(cuid())
  orderId           String
  sellerId          String
  status            PackageStatus @default(PENDING)
  trackingNumber    String?
  estimatedDelivery DateTime?

  order     Order       @relation(fields: [orderId], references: [id])
  lines     OrderLine[]
  shipments Shipment[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

enum PackageStatus {
  PENDING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderLine {
  id              String  @id @default(cuid())
  packageId       String
  variantId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  discountApplied Decimal @default(0) @db.Decimal(12, 2)

  package       OrderPackage        @relation(fields: [packageId], references: [id])
  variant       ProductVariant      @relation(fields: [variantId], references: [id])
  ledgerEntries SellerLedgerEntry[]
  returns       ReturnShipment[]
  disputes      Dispute[]
  reviews       Review[]
  conversions   AdConversion[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String     @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@unique([userId, sessionId], name: "userId_sessionId")
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  variantId     String
  sellerId      String
  quantity      Int
  priceSnapshot Decimal @db.Decimal(12, 2)

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}
